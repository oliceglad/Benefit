# Скопируйте в .env: cp .env.example .env

# Application
APP_NAME=Benefit
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=benefit
POSTGRES_USER=benefit
POSTGRES_PASSWORD=benefit

# --- API gateway ------------------------------------------------------------
# Единственная точка входа: все запросы к API идут через шлюз.
GATEWAY_PORT=8000

# --- Auth service -----------------------------------------------------------
# Публичный адрес auth-service (через шлюз): issuer токенов и redirect_uri.
AUTH_PUBLIC_URL=http://localhost:8000
AUTH_DB_PORT=5433
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth
# Секрет для HMAC кодов подтверждения. В production обязательно сменить.
AUTH_SECRET_KEY=change-me
# Токен для межсервисных вызовов (auth-service -> mail-service).
INTERNAL_API_TOKEN=change-me
# Страница фронтенда, куда вернуть браузер после входа через ФСП ID / Keycloak.
# Пусто — отладочная страница auth-service, сразу показывающая токены.
OAUTH_FRONTEND_CALLBACK_URL=

# --- Candidate service ------------------------------------------------------
CANDIDATE_DB_PORT=5434
CANDIDATE_DB_NAME=candidates
CANDIDATE_DB_USER=candidates
CANDIDATE_DB_PASSWORD=candidates

# --- Mail service -----------------------------------------------------------
MAIL_FROM=Benefit <no-reply@benefit.ru>
# По умолчанию письма уходят в Mailpit: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
MAILPIT_UI_PORT=8025

# --- ФСП ID (имитация) ------------------------------------------------------
FSP_ID_ENABLED=true
FSP_ID_PORT=8003
FSP_ID_CLIENT_ID=benefit
FSP_ID_CLIENT_SECRET=fsp-dev-secret

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ENABLED=true
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=benefit-keycloak-dev-secret
