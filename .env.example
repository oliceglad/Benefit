# Скопируйте в .env: cp .env.example .env

# Application
APP_NAME=Benefit
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=benefit
POSTGRES_USER=benefit
POSTGRES_PASSWORD=benefit

# --- API gateway ------------------------------------------------------------
# Единственная точка входа: все запросы к API идут через шлюз.
GATEWAY_PORT=8000

# --- Токены в cookie ---------------------------------------------------------
# Secure-cookie: в production обязательно true (только HTTPS).
COOKIE_SECURE=false
# Адреса фронтенда (WebSocket по cookie принимается только с них).
TRUSTED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Auth service -----------------------------------------------------------
# Публичный адрес auth-service (через шлюз): issuer токенов и redirect_uri.
AUTH_PUBLIC_URL=http://localhost:8000
AUTH_DB_PORT=5433
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth
# Секрет для HMAC кодов подтверждения. В production обязательно сменить.
AUTH_SECRET_KEY=change-me
# Токен для межсервисных вызовов (auth-service -> mail-service).
INTERNAL_API_TOKEN=change-me
# Страница фронтенда, куда вернуть браузер после входа через ФСП ID / Keycloak.
# Пусто — отладочная страница auth-service, сразу показывающая токены.
OAUTH_FRONTEND_CALLBACK_URL=

# --- Candidate service ------------------------------------------------------
CANDIDATE_DB_PORT=5434
CANDIDATE_DB_NAME=candidates
CANDIDATE_DB_USER=candidates
CANDIDATE_DB_PASSWORD=candidates

# --- Assessment service (тестирование грейда) --------------------------------
ASSESSMENT_DB_PORT=5435
ASSESSMENT_DB_NAME=assessments
ASSESSMENT_DB_USER=assessments
ASSESSMENT_DB_PASSWORD=assessments
# Повторный тест в той же специализации — не раньше чем через N часов.
ASSESSMENT_ATTEMPT_COOLDOWN_HOURS=168

# --- Applications service (приглашения) -------------------------------------
APPLICATIONS_DB_PORT=5437
APPLICATIONS_DB_NAME=applications
APPLICATIONS_DB_USER=applications
APPLICATIONS_DB_PASSWORD=applications

# --- Notification service ---------------------------------------------------
NOTIFICATION_DB_PORT=5436
NOTIFICATION_DB_NAME=notifications
NOTIFICATION_DB_USER=notifications
NOTIFICATION_DB_PASSWORD=notifications
# Адрес фронтенда для ссылок в письмах.
FRONTEND_URL=http://localhost:3000

# --- Chat service (переписка и регулярные задания) --------------------------
CHAT_DB_PORT=5438
CHAT_DB_NAME=chat
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=chat

# --- Employer service (компания, потребности, вакансии) ---------------------
EMPLOYER_DB_PORT=5439
EMPLOYER_DB_NAME=employers
EMPLOYER_DB_USER=employers
EMPLOYER_DB_PASSWORD=employers

# --- Matching service (поиск и подбор кандидатов) ---------------------------
MATCHING_DB_PORT=5440
MATCHING_DB_NAME=matching
MATCHING_DB_USER=matching
MATCHING_DB_PASSWORD=matching

# --- Mail service -----------------------------------------------------------
MAIL_FROM=Benefit <no-reply@benefit.ru>
# По умолчанию письма уходят в Mailpit: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
MAILPIT_UI_PORT=8025

# --- ФСП ID (имитация) ------------------------------------------------------
FSP_ID_ENABLED=true
FSP_ID_PORT=8003
FSP_ID_CLIENT_ID=benefit
FSP_ID_CLIENT_SECRET=fsp-dev-secret

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ENABLED=true
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=benefit-keycloak-dev-secret

# --- Мониторинг -------------------------------------------------------------
# Grafana: http://localhost:3001 (сменить пароль в production).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=benefit-grafana
PROMETHEUS_RETENTION=15d
# Куда слать алерты (по умолчанию — Mailpit, http://localhost:8025).
ALERT_EMAIL_TO=ops@benefit.local
ALERT_EMAIL_FROM=alerts@benefit.local
ALERT_SMTP_HOST=mailpit:1025
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=false
