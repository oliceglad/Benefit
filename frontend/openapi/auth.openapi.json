            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "IdentityResponse": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "email",
          "created_at"
        ],
        "title": "IdentityResponse",
        "description": "Привязанный внешний аккаунт (ФСП ID, Keycloak)."
      },
      "InternalIdentityResponse": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "email",
          "created_at",
          "subject"
        ],
        "title": "InternalIdentityResponse",
        "description": "Для других сервисов: включает идентификатор во внешней системе."
      },
      "InternalUserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
