{
  "openapi": "3.1.0",
  "info": {
    "title": "Benefit Matching",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/talent/candidates": {
      "get": {
        "tags": [
          "talent: банк кандидатов"
        ],
        "summary": "Search Candidates",
        "description": "Поиск с фасетами по категориям (специализация + грейд + подтверждение).",
        "operationId": "search_candidates_api_v1_talent_candidates_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "specialization",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ITRole"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Specialization"
            }
          },
          {
            "name": "grade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Grade"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Grade"
            }
          },
          {
            "name": "grade_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "confirmed",
                    "not_confirmed"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Grade Status"
            }
          },
          {
            "name": "skills",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Навыки",
              "title": "Skills"
            },
            "description": "Навыки"
          },
          {
            "name": "skills_mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "any"
              ],
              "type": "string",
              "description": "all — все навыки, any — любой",
              "default": "all",
              "title": "Skills Mode"
            },
            "description": "all — все навыки, any — любой"
          },
          {
            "name": "has_fsp",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Есть подтверждённые достижения ФСП",
              "title": "Has Fsp"
            },
            "description": "Есть подтверждённые достижения ФСП"
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Industry"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Industry"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "City"
            }
          },
          {
            "name": "work_format",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/WorkFormat"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Work Format"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Полнотекстовый поиск",
              "title": "Q"
            },
            "description": "Полнотекстовый поиск"
          },
          {
            "name": "experience_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 50,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Лет",
              "title": "Experience Min"
            },
            "description": "Лет"
          },
          {
            "name": "experience_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 50,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Лет",
              "title": "Experience Max"
            },
            "description": "Лет"
          },
          {
            "name": "salary_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Бюджет: ожидания не выше",
              "title": "Salary Max"
            },
            "description": "Бюджет: ожидания не выше"
          },
          {
            "name": "active_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Только с активностью за 30 дней",
              "default": false,
              "title": "Active Only"
            },
            "description": "Только с активностью за 30 дней"
          },
          {
            "name": "include_not_looking",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Not Looking"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "relevance",
                "skills",
                "actuality",
                "experience",
                "fsp"
              ],
              "type": "string",
              "default": "relevance",
              "title": "Sort"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/talent/candidates/{user_id}/similar": {
      "get": {
        "tags": [
          "talent: банк кандидатов"
        ],
        "summary": "Similar Candidates",
        "description": "Похожие кандидаты: общий стек, специализация, близкий грейд.",
        "operationId": "similar_candidates_api_v1_talent_candidates__user_id__similar_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "User Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SimilarCandidate"
                  },
                  "title": "Response Similar Candidates Api V1 Talent Candidates  User Id  Similar Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/match": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Match",
        "operationId": "match_internal_v1_match_post",
        "parameters": [
          {
            "name": "x-internal-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Internal-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchCriteria"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
