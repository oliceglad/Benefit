    "@tanstack/react-query": "5.99.0",
    "@tanstack/react-router": "1.168.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.1",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "zod": "4.3.6"
